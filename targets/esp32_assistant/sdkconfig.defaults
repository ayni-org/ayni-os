# ESP32-S3 N16R8 (board model unverified; MA-001). Values here are the M0
# Hello baseline only; the partition layout is fixed after measuring the real
# firmware (plan section 4.2).
CONFIG_IDF_TARGET="esp32s3"

# 2 MB, the smallest flash on any ESP32-S3 module. An image whose header names
# more flash than the chip has stops at boot, before the baseline log; the
# Hello firmware logs the physical size from esp_flash_get_physical_size, and
# the size and layout are set from that measurement.
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y

# 8 MB octal PSRAM. Keep booting if the module turns out to differ, so the
# baseline log can report what is actually fitted.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
